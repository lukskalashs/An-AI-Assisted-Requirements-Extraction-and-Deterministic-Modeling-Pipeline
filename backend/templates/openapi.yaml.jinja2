openapi: 3.0.0
info:
  title: Auto-Generated Domain API
  description: RESTful API contract generated via AI-Assisted Requirements Pipeline.
  version: 1.0.0
paths:
{% for cls in classes %}
  /{{ cls.name | lower }}s:
    get:
      summary: Retrieve all {{ cls.name }}s
      responses:
        '200':
          description: A list of {{ cls.name }}s
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/{{ cls.name }}'
        '401':
          description: Unauthorized
        '500':
          description: Internal Server Error
    post:
      summary: Create a new {{ cls.name }}
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/{{ cls.name }}'
      responses:
        '201':
          description: Successfully created
        '400':
          description: Bad Request

  /{{ cls.name | lower }}s/{id}:
    get:
      summary: Get a {{ cls.name }} by ID
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: integer
      responses:
        '200':
          description: Successful operation
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/{{ cls.name }}'
        '404':
          description: Not Found
    put:
      summary: Update an existing {{ cls.name }}
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: integer
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/{{ cls.name }}'
      responses:
        '200':
          description: Successfully updated
        '404':
          description: Not Found
    delete:
      summary: Delete a {{ cls.name }}
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: integer
      responses:
        '204':
          description: Successfully deleted
        '404':
          description: Not Found
{% endfor %}

{% for route in nested_routes %}
  /{{ route.parent_path }}/{id}/{{ route.child_path }}:
    get:
      summary: Retrieve all {{ route.child_path }} for a specific {{ route.parent }}
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: integer
      responses:
        '200':
          description: A list of related resources
          content:
            application/json:
              schema:
                type: array
                items:
{% if route.is_junction %}
                  type: object
                  properties:
                    applicationDate:
                      type: string
                      format: date-time
                    status:
                      type: string
{% else %}
                  $ref: '#/components/schemas/{{ route.child }}'
{% endif %}
    post:
      summary: Create a new {{ route.child }} under {{ route.parent }}
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: integer
      responses:
        '201':
          description: Successfully created
{% endfor %}

components:
  schemas:
{% for cls in classes %}
    {{ cls.name }}:
      type: object
      properties:
        {{ cls.pk_name }}:
          type: integer
{% for attr in cls.attributes %}
        {{ attr.name }}:
{% for key, value in attr.schema.items() %}
{% if key == "items" %}
          items:
            type: {{ value.type }}
{% else %}
          {{ key }}: {{ value }}
{% endif %}
{% endfor %}
{% endfor %}
{% endfor %}